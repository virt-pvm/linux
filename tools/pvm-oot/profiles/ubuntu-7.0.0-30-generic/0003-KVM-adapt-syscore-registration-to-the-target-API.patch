From 01fbe45aab391dd6292d697fa93766ef01a3f1cd Mon Sep 17 00:00:00 2001
From: hky1999 <hukeyang.hky@antgroup.com>
Date: Fri, 9 Oct 2026 22:54:49 +0800
Subject: [PATCH 3/5] KVM: adapt syscore registration to the target API

Separate registration state from the const callbacks and adapt their
data argument. Preserve KVM registration and unwind ordering.

Signed-off-by: hky1999 <hukeyang.hky@antgroup.com>
---
 virt/kvm/syscore.h | 31 +++++++++++++++++++++++++------
 1 file changed, 25 insertions(+), 6 deletions(-)

diff --git a/virt/kvm/syscore.h b/virt/kvm/syscore.h
index 45a60af..5087986 100644
--- a/virt/kvm/syscore.h
+++ b/virt/kvm/syscore.h
@@ -1,17 +1,36 @@
 /* SPDX-License-Identifier: GPL-2.0 */
 /* Included after the KVM suspend/resume/shutdown callbacks. */
-static struct syscore_ops kvm_syscore_ops = {
-	.suspend = kvm_suspend,
-	.resume = kvm_resume,
-	.shutdown = kvm_shutdown,
+static int kvm_syscore_suspend(void *data)
+{
+	return kvm_suspend();
+}
+
+static void kvm_syscore_resume(void *data)
+{
+	kvm_resume();
+}
+
+static void kvm_syscore_shutdown(void *data)
+{
+	kvm_shutdown();
+}
+
+static const struct syscore_ops kvm_syscore_ops = {
+	.suspend = kvm_syscore_suspend,
+	.resume = kvm_syscore_resume,
+	.shutdown = kvm_syscore_shutdown,
+};
+
+static struct syscore kvm_syscore = {
+	.ops = &kvm_syscore_ops,
 };
 
 static void kvm_register_syscore(void)
 {
-	register_syscore_ops(&kvm_syscore_ops);
+	register_syscore(&kvm_syscore);
 }
 
 static void kvm_unregister_syscore(void)
 {
-	unregister_syscore_ops(&kvm_syscore_ops);
+	unregister_syscore(&kvm_syscore);
 }
