From 81650e57175316520397e099e2f857b1eae596ca Mon Sep 17 00:00:00 2001
From: hky1999 <hukeyang.hky@antgroup.com>
Date: Fri, 9 Oct 2026 22:54:49 +0800
Subject: [PATCH 2/5] KVM: use the target hrtimer setup API

Pass the real callback during setup. Keep call sites and the timer
clock/mode unchanged; a NULL setup callback is invalid on this host.

Signed-off-by: hky1999 <hukeyang.hky@antgroup.com>
---
 arch/x86/kvm/hrtimer.h | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/arch/x86/kvm/hrtimer.h b/arch/x86/kvm/hrtimer.h
index 8d40aa4..36ae00b 100644
--- a/arch/x86/kvm/hrtimer.h
+++ b/arch/x86/kvm/hrtimer.h
@@ -7,7 +7,6 @@ static inline void kvm_hrtimer_init(struct hrtimer *timer, clockid_t clock,
 				    enum hrtimer_mode mode,
 				    enum hrtimer_restart (*callback)(struct hrtimer *))
 {
-	hrtimer_init(timer, clock, mode);
-	timer->function = callback;
+	hrtimer_setup(timer, callback, clock, mode);
 }
 #endif
