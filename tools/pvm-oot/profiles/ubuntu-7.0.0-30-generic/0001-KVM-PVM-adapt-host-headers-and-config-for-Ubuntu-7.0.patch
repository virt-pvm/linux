From e257eece4695279a39580b8d11451531b4b161d9 Mon Sep 17 00:00:00 2001
From: hky1999 <hukeyang.hky@antgroup.com>
Date: Fri, 9 Oct 2026 22:54:49 +0800
Subject: [PATCH 1/5] KVM: PVM: adapt host headers and config for Ubuntu
 7.0.0-30

Use the headers and feature names shipped by this exact Ubuntu ABI.
Keep notifier selection local to the 6.12 source core and map renamed
guest-work and guest-memfd options, including the source-owned object list.
This is a target patch, not a version-number support test.

Signed-off-by: hky1999 <hukeyang.hky@antgroup.com>
---
 arch/x86/kvm/include/asm/cpuid.h       | 10 ++++++++++
 arch/x86/kvm/include/asm/hyperv-tlfs.h |  3 +++
 arch/x86/kvm/include/asm/msr.h         |  7 +++++++
 arch/x86/kvm/include/asm/vmx.h         |  5 +++++
 arch/x86/kvm/include/linux/entry-kvm.h |  4 ++++
 arch/x86/kvm/include/linux/kvm_host.h  | 13 +++++++++++++
 arch/x86/kvm/include/linux/timer.h     |  8 ++++++++
 arch/x86/kvm/reverse_cpuid.h           |  1 -
 virt/kvm/Makefile.kvm                  |  2 +-
 9 files changed, 51 insertions(+), 2 deletions(-)
 create mode 100644 arch/x86/kvm/include/asm/cpuid.h
 create mode 100644 arch/x86/kvm/include/asm/hyperv-tlfs.h
 create mode 100644 arch/x86/kvm/include/asm/msr.h
 create mode 100644 arch/x86/kvm/include/asm/vmx.h
 create mode 100644 arch/x86/kvm/include/linux/entry-kvm.h
 create mode 100644 arch/x86/kvm/include/linux/timer.h

diff --git a/arch/x86/kvm/include/asm/cpuid.h b/arch/x86/kvm/include/asm/cpuid.h
new file mode 100644
index 0000000..703d5eb
--- /dev/null
+++ b/arch/x86/kvm/include/asm/cpuid.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef PVM_OOT_ASM_CPUID_H
+#define PVM_OOT_ASM_CPUID_H
+#include <asm/cpuid/api.h>
+
+#ifndef for_each_possible_hypervisor_cpuid_base
+#define for_each_possible_hypervisor_cpuid_base(function) \
+	for (function = 0x40000000; function < 0x40010000; function += 0x100)
+#endif
+#endif
diff --git a/arch/x86/kvm/include/asm/hyperv-tlfs.h b/arch/x86/kvm/include/asm/hyperv-tlfs.h
new file mode 100644
index 0000000..67cce45
--- /dev/null
+++ b/arch/x86/kvm/include/asm/hyperv-tlfs.h
@@ -0,0 +1,3 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <hyperv/hvhdk.h>
+#include <hyperv/hvgdk.h>
diff --git a/arch/x86/kvm/include/asm/msr.h b/arch/x86/kvm/include/asm/msr.h
new file mode 100644
index 0000000..b9d49ca
--- /dev/null
+++ b/arch/x86/kvm/include/asm/msr.h
@@ -0,0 +1,7 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include_next <asm/msr.h>
+
+#define rdmsrl_safe rdmsrq_safe
+#define wrmsrl_safe wrmsrq_safe
+#define rdmsrl_safe_on_cpu rdmsrq_safe_on_cpu
+#define wrmsrl_safe_on_cpu wrmsrq_safe_on_cpu
diff --git a/arch/x86/kvm/include/asm/vmx.h b/arch/x86/kvm/include/asm/vmx.h
new file mode 100644
index 0000000..3cf0980
--- /dev/null
+++ b/arch/x86/kvm/include/asm/vmx.h
@@ -0,0 +1,5 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include_next <asm/vmx.h>
+#ifndef EPT_VIOLATION_RWX_SHIFT
+#define EPT_VIOLATION_RWX_SHIFT 3
+#endif
diff --git a/arch/x86/kvm/include/linux/entry-kvm.h b/arch/x86/kvm/include/linux/entry-kvm.h
new file mode 100644
index 0000000..950c3a2
--- /dev/null
+++ b/arch/x86/kvm/include/linux/entry-kvm.h
@@ -0,0 +1,4 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/entry-virt.h>
+/* Newer kernels made transfer-to-guest handling independent of KVM. */
+#define xfer_to_guest_mode_handle_work(vcpu) xfer_to_guest_mode_handle_work()
diff --git a/arch/x86/kvm/include/linux/kvm_host.h b/arch/x86/kvm/include/linux/kvm_host.h
index 91ec88d..205c5f3 100644
--- a/arch/x86/kvm/include/linux/kvm_host.h
+++ b/arch/x86/kvm/include/linux/kvm_host.h
@@ -1,5 +1,18 @@
 /* SPDX-License-Identifier: GPL-2.0 */
 #ifndef __PVM_OOT_WRAPPER_ARCH_X86_KVM_INCLUDE_LINUX_KVM_HOST_H__
 #define __PVM_OOT_WRAPPER_ARCH_X86_KVM_INCLUDE_LINUX_KVM_HOST_H__
+/* Preserve the 6.12 core layout and notifier implementation. */
+#define CONFIG_KVM_GENERIC_MMU_NOTIFIER 1
+#if defined(CONFIG_VIRT_XFER_TO_GUEST_WORK)
+#define CONFIG_KVM_XFER_TO_GUEST_WORK 1
+#endif
+#if defined(CONFIG_KVM_GUEST_MEMFD)
+#define CONFIG_KVM_PRIVATE_MEM 1
+#endif
 #include "../../../../../include/linux/kvm_host.h"
+#ifndef KVM_X86_DISABLE_VALID_EXITS
+#define KVM_X86_DISABLE_VALID_EXITS (KVM_X86_DISABLE_EXITS_MWAIT | \
+	KVM_X86_DISABLE_EXITS_HLT | KVM_X86_DISABLE_EXITS_PAUSE | \
+	KVM_X86_DISABLE_EXITS_CSTATE)
+#endif
 #endif
diff --git a/arch/x86/kvm/include/linux/timer.h b/arch/x86/kvm/include/linux/timer.h
new file mode 100644
index 0000000..c2c2ca8
--- /dev/null
+++ b/arch/x86/kvm/include/linux/timer.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef PVM_OOT_LINUX_TIMER_H
+#define PVM_OOT_LINUX_TIMER_H
+#include_next <linux/timer.h>
+#define del_timer timer_delete
+#define del_timer_sync timer_delete_sync
+#define from_timer timer_container_of
+#endif
diff --git a/arch/x86/kvm/reverse_cpuid.h b/arch/x86/kvm/reverse_cpuid.h
index 0d17d6b..652f680 100644
--- a/arch/x86/kvm/reverse_cpuid.h
+++ b/arch/x86/kvm/reverse_cpuid.h
@@ -87,7 +87,6 @@ static const struct cpuid_reg reverse_cpuid[] = {
 	[CPUID_6_EAX]         = {         6, 0, CPUID_EAX},
 	[CPUID_8000_000A_EDX] = {0x8000000a, 0, CPUID_EDX},
 	[CPUID_7_ECX]         = {         7, 0, CPUID_ECX},
-	[CPUID_8000_0007_EBX] = {0x80000007, 0, CPUID_EBX},
 	[CPUID_7_EDX]         = {         7, 0, CPUID_EDX},
 	[CPUID_7_1_EAX]       = {         7, 1, CPUID_EAX},
 	[CPUID_12_EAX]        = {0x00000012, 0, CPUID_EAX},
diff --git a/virt/kvm/Makefile.kvm b/virt/kvm/Makefile.kvm
index 724c89a..d047d4c 100644
--- a/virt/kvm/Makefile.kvm
+++ b/virt/kvm/Makefile.kvm
@@ -12,4 +12,4 @@ kvm-$(CONFIG_KVM_ASYNC_PF) += $(KVM)/async_pf.o
 kvm-$(CONFIG_HAVE_KVM_IRQ_ROUTING) += $(KVM)/irqchip.o
 kvm-$(CONFIG_HAVE_KVM_DIRTY_RING) += $(KVM)/dirty_ring.o
 kvm-$(CONFIG_HAVE_KVM_PFNCACHE) += $(KVM)/pfncache.o
-kvm-$(CONFIG_KVM_PRIVATE_MEM) += $(KVM)/guest_memfd.o
+kvm-$(CONFIG_KVM_GUEST_MEMFD) += $(KVM)/guest_memfd.o
