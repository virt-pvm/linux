From f7bb6c1cf933493cf90eb806710402e1e701016a Mon Sep 17 00:00:00 2001
From: Hou Wenlong <houwenlong.hwl@antgroup.com>
Date: Sat, 10 Oct 2026 16:37:17 +0800
Subject: [PATCH] KVM: PVM: adapt to Ubuntu 24.04 6.8.0-139


Use the target eventfd and shrinker APIs. Supply OOT feature definitions
and guard trace definitions absent from the target headers.

Assisted-by: Codex:GPT-6.1
Signed-off-by: Hou Wenlong <houwenlong.hwl@antgroup.com>
---
 arch/x86/kvm/hyperv.c                   |  2 +-
 arch/x86/kvm/include/linux/kvm_host.h   |  2 ++
 arch/x86/kvm/include/trace/events/kvm.h |  1 +
 arch/x86/kvm/mmu/mmu.c                  | 18 ++++++++++--------
 arch/x86/kvm/xen.c                      |  2 +-
 virt/kvm/eventfd.c                      |  4 ++--
 virt/kvm/kvm_main.c                     |  2 ++
 7 files changed, 19 insertions(+), 12 deletions(-)

diff --git a/arch/x86/kvm/hyperv.c b/arch/x86/kvm/hyperv.c
index feaea83e6e0b..391bd4ccb227 100644
--- a/arch/x86/kvm/hyperv.c
+++ b/arch/x86/kvm/hyperv.c
@@ -2400,7 +2400,7 @@ static u16 kvm_hvcall_signal_event(struct kvm_vcpu *vcpu, struct kvm_hv_hcall *h
 	if (!eventfd)
 		return HV_STATUS_INVALID_PORT_ID;
 
-	eventfd_signal(eventfd, 1);
+	eventfd_signal(eventfd);
 	return HV_STATUS_SUCCESS;
 }
 
diff --git a/arch/x86/kvm/include/linux/kvm_host.h b/arch/x86/kvm/include/linux/kvm_host.h
index 91ec88d52df1..db3baf297381 100644
--- a/arch/x86/kvm/include/linux/kvm_host.h
+++ b/arch/x86/kvm/include/linux/kvm_host.h
@@ -1,5 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0 */
 #ifndef __PVM_OOT_WRAPPER_ARCH_X86_KVM_INCLUDE_LINUX_KVM_HOST_H__
 #define __PVM_OOT_WRAPPER_ARCH_X86_KVM_INCLUDE_LINUX_KVM_HOST_H__
+#define CONFIG_HAVE_KVM_EVENTFD 1
+#define CONFIG_HAVE_KVM_IRQFD 1
 #include "../../../../../include/linux/kvm_host.h"
 #endif
diff --git a/arch/x86/kvm/include/trace/events/kvm.h b/arch/x86/kvm/include/trace/events/kvm.h
index acb226471c6d..4959763af49a 100644
--- a/arch/x86/kvm/include/trace/events/kvm.h
+++ b/arch/x86/kvm/include/trace/events/kvm.h
@@ -1,2 +1,3 @@
 /* SPDX-License-Identifier: GPL-2.0 */
 #include "../../../../../../include/trace/events/kvm.h"
+#define trace_kvm_set_irq(irq, level, source_id) do { } while (0)
diff --git a/arch/x86/kvm/mmu/mmu.c b/arch/x86/kvm/mmu/mmu.c
index 96f19dc6b29b..74d65b972463 100644
--- a/arch/x86/kvm/mmu/mmu.c
+++ b/arch/x86/kvm/mmu/mmu.c
@@ -6861,11 +6861,7 @@ static unsigned long mmu_shrink_count(struct shrinker *shrink,
 	return percpu_counter_read_positive(&kvm_total_used_mmu_pages);
 }
 
-static struct shrinker mmu_shrinker = {
-	.count_objects = mmu_shrink_count,
-	.scan_objects = mmu_shrink_scan,
-	.seeks = DEFAULT_SEEKS * 10,
-};
+static struct shrinker *mmu_shrinker;
 
 static void mmu_destroy_caches(void)
 {
@@ -6998,10 +6994,16 @@ int kvm_mmu_vendor_module_init(void)
 	if (percpu_counter_init(&kvm_total_used_mmu_pages, 0, GFP_KERNEL))
 		goto out;
 
-	ret = register_shrinker(&mmu_shrinker, "x86-mmu");
-	if (ret)
+	mmu_shrinker = shrinker_alloc(0, "x86-mmu");
+	if (!mmu_shrinker)
 		goto out_shrinker;
 
+	mmu_shrinker->count_objects = mmu_shrink_count;
+	mmu_shrinker->scan_objects = mmu_shrink_scan;
+	mmu_shrinker->seeks = DEFAULT_SEEKS * 10;
+
+	shrinker_register(mmu_shrinker);
+
 	return 0;
 
 out_shrinker:
@@ -7023,7 +7025,7 @@ void kvm_mmu_vendor_module_exit(void)
 {
 	mmu_destroy_caches();
 	percpu_counter_destroy(&kvm_total_used_mmu_pages);
-	unregister_shrinker(&mmu_shrinker);
+	shrinker_free(mmu_shrinker);
 }
 
 /*
diff --git a/arch/x86/kvm/xen.c b/arch/x86/kvm/xen.c
index 45260b47af78..5e812d5aa9aa 100644
--- a/arch/x86/kvm/xen.c
+++ b/arch/x86/kvm/xen.c
@@ -2054,7 +2054,7 @@ static bool kvm_xen_hcall_evtchn_send(struct kvm_vcpu *vcpu, u64 param, u64 *r)
 		if (ret < 0 && ret != -ENOTCONN)
 			return false;
 	} else {
-		eventfd_signal(evtchnfd->deliver.eventfd.ctx, 1);
+		eventfd_signal(evtchnfd->deliver.eventfd.ctx);
 	}
 
 	*r = 0;
diff --git a/virt/kvm/eventfd.c b/virt/kvm/eventfd.c
index 10a657cf333e..db4137575d3e 100644
--- a/virt/kvm/eventfd.c
+++ b/virt/kvm/eventfd.c
@@ -61,7 +61,7 @@ static void irqfd_resampler_notify(struct kvm_kernel_irqfd_resampler *resampler)
 
 	list_for_each_entry_srcu(irqfd, &resampler->list, resampler_link,
 				 srcu_read_lock_held(&resampler->kvm->irq_srcu))
-		eventfd_signal(irqfd->resamplefd, 1);
+		eventfd_signal(irqfd->resamplefd);
 }
 
 /*
@@ -791,7 +791,7 @@ ioeventfd_write(struct kvm_vcpu *vcpu, struct kvm_io_device *this, gpa_t addr,
 	if (!ioeventfd_in_range(p, addr, len, val))
 		return -EOPNOTSUPP;
 
-	eventfd_signal(p->eventfd, 1);
+	eventfd_signal(p->eventfd);
 	return 0;
 }
 
diff --git a/virt/kvm/kvm_main.c b/virt/kvm/kvm_main.c
index 46ac8d1b26fc..1aaf867dbb22 100644
--- a/virt/kvm/kvm_main.c
+++ b/virt/kvm/kvm_main.c
@@ -5146,11 +5146,13 @@ static long kvm_dev_ioctl(struct file *filp,
 		r += PAGE_SIZE;    /* coalesced mmio ring page */
 #endif
 		break;
+#ifdef KVM_TRACE_ENABLE
 	case KVM_TRACE_ENABLE:
 	case KVM_TRACE_PAUSE:
 	case KVM_TRACE_DISABLE:
 		r = -EOPNOTSUPP;
 		break;
+#endif
 	default:
 		return kvm_arch_dev_ioctl(filp, ioctl, arg);
 	}
